package cordis:core@0.1.0;

interface context {
    /// 跨边界值（v1 标量集；case 名避开 WIT 关键字）。
    variant value {
        flag(bool),
        count(u64),
        offset(s64),
        text(string),
        blob(list<u8>),
    }
    resource inverse {
        /// 撤销绑定（Def 8 的逆）。**宿主专用（审查 m4）**：撤销由宿主
        /// 在组件卸载路径驱动（经 rep 表执行核心逆）；guest **不得调用**
        /// ——guest 侧调用为协议违反（宿主 panic = bug）。
        run: func();
    }
    get: func(key: string) -> option<value>;
    set: func(key: string, value: value) -> result<inverse, string>;
}

interface remote {
    use context.{value};
    resource handle {
        /// 取结果（轮询）：未就绪 → none；就绪 → ok(value) / err(string)。
        /// guest 在后续 step 调用；host 保证不 panic。
        take: func() -> option<result<value, string>>;
    }
    /// 提交宿主已注册的远端操作（M1 wasm 桥 W-D2）：操作名 + 参数值。
    submit: func(name: string, params: list<value>) -> handle;
}

interface plugin {
    use context.{inverse};
    resource task {
        step: func() -> option<effect-step>;
    }
    /// 效应步（A2b 修法①：显式 variant，消除 option<resource> 编码坑——
    /// `invalid option discriminant` 根因）。
    variant effect-step {
        /// 有逆的效应步（继续；逆由宿主经 pending 转发机制收账）。
        step(inverse),
        /// 终止步（可带最后效应逆）。
        done(inverse),
        /// 等待远端（无逆；宿主以 `Step::Await` 暂停，回填后 advance 恢复）。
        wait,
    }
    resource component {
        constructor();
        inject: func() -> list<string>;
        provide: func() -> list<string>;
        start: func() -> task;
    }
}

world cordis {
    import context;
    import remote;
    export plugin;
}
